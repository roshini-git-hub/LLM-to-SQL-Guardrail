# Copy this file to .env and fill in the values. .env is git-ignored.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=guardrail_db

# Login used by the guardrail (read-only role, see scripts/03_roles.sql)
DB_USER=guardrail_ro
DB_PASSWORD=change-me

# Superuser/owner used only to run the setup scripts in scripts/ (never by the app)
ADMIN_USER=postgres
ADMIN_PASSWORD=

DB_STATEMENT_TIMEOUT_MS=5000
DB_POOL_MIN=1
DB_POOL_MAX=10

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
